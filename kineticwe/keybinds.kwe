# KineticWE keybinds — generated by Kinetic Settings. Only binds that
# differ from the defaults are stored. Copy this file into your dotfiles
# (or to another machine's ~/.config/kineticwe/) to share your binds; it
# is re-applied at every session start.
[kineticwe][Global Shortcuts]
Window Move Center=Meta+F
Tiling Cycle Layout=Meta+Ctrl+`
Window to Desktop 1=Meta+Ctrl+1
Window to Desktop 2=Meta+Ctrl+2
Window to Desktop 3=Meta+Ctrl+3
Window to Desktop 4=Meta+Ctrl+4
Window to Desktop 5=Meta+Ctrl+5
[applications][Global Shortcuts]
kitty=Meta+T
org.kde.spectacle=Meta+Shift+S
thunar=Meta+E
